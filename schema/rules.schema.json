{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/elementor-dynamic-select/rules.schema.json",
  "title": "Elementor Dynamic Select Ruleset",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "match": {
          "type": "string",
          "enum": ["first", "merge"]
        },
        "preserveSelection": {
          "type": "boolean"
        },
        "emptyText": {
          "type": "string"
        },
        "noMatchText": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "optionSets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/option"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/rule"
      }
    },
    "default": {
      "$ref": "#/definitions/optionBlock"
    }
  },
  "definitions": {
    "option": {
      "type": "object",
      "required": ["value", "label"],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string"
        }
      }
    },
    "condition": {
      "type": "object",
      "required": ["field", "operator"],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": [
            "includes",
            "includesAll",
            "includesAny",
            "intersects",
            "equals",
            "in",
            "any"
          ]
        },
        "value": {}
      }
    },
    "when": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "all": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "any": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          }
        }
      },
      "anyOf": [
        {
          "required": ["all"]
        },
        {
          "required": ["any"]
        }
      ]
    },
    "optionBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "use": {
          "type": ["string", "null"]
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/option"
          }
        }
      },
      "anyOf": [
        {
          "required": ["use"]
        },
        {
          "required": ["options"]
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["when"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "when": {
          "$ref": "#/definitions/when"
        },
        "use": {
          "type": "string"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/option"
          }
        }
      },
      "anyOf": [
        {
          "required": ["use"]
        },
        {
          "required": ["options"]
        }
      ]
    }
  }
}
